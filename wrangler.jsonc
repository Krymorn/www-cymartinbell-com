{
  // Cloudflare Workers config: static site + one small API route for /tools.
  "name": "www-cymartinbell-com",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/tools/api/*"]
  }
}
